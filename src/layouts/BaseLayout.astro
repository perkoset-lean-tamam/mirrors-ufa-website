---
import '../styles/global.css';
import {
  COUNTER_API_BASE,
  COUNTER_API_KEY,
  COUNTER_ENABLED,
  COUNTER_NAME,
  COUNTER_WORKSPACE,
  MAX_URL,
  VISIT_SESSION_KEY,
} from '../consts';

export interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Зеркала на заказ в Уфе — изготовление и установка зеркал, душевых кабин, стеклянных перегородок. Замер 500 ₽, доставка 600 ₽. Работаем по Уфе и районам города.',
  noIndex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const skipVisitCount = noIndex || pathname === '/stats' || pathname === '/404';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="ru" href={new URL(Astro.url.pathname, Astro.site)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
    <meta name="theme-color" content="#F4F0EA" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Зеркала Уфы" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Зеркало в латунной раме — мастерская в Уфе" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: 'Зеркала Уфы',
        description:
          'Изготовление и установка зеркал, душевых кабин, стеклянных перегородок на заказ в Уфе и районах.',
        url: 'https://mirrors-ufa.ru',
        telephone: '+79373398232',
        image: 'https://mirrors-ufa.ru/og-image.jpg',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Уфа',
          addressRegion: 'Республика Башкортостан',
          addressCountry: 'RU',
        },
        areaServed: [
          { '@type': 'City', name: 'Уфа' },
          { '@type': 'AdministrativeArea', name: 'Уфимский район' },
        ],
        priceRange: '500-50000 ₽',
        founder: {
          '@type': 'Person',
          name: 'Олег Артемьев',
        },
      })}
    />
  </head>
  <body class="bg-background font-body text-ink antialiased">
    <header class="sticky top-0 z-50 bg-background/85 backdrop-blur-md border-b border-line">
      <div class="px-gutter h-16 lg:h-20 flex items-center justify-between gap-6">
        <a href="/" class="font-display text-xl lg:text-2xl tracking-[-0.01em] text-ink">
          Зеркала Уфы
        </a>
        <nav class="hidden md:flex items-center gap-8" aria-label="Основная навигация">
          <a href="#services" class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300">Услуги</a>
          <a href="#gallery" class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300">Работы</a>
          <a href="#contacts" class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300">Контакты</a>
          <a href="#faq" class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300">Вопросы</a>
        </nav>
        <a href={MAX_URL} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex items-center gap-2 bg-brass text-surface rounded-sm px-5 py-2 min-h-[44px] font-body text-sm transition-transform duration-300 motion-safe:hover:translate-y-[-1px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2">
          Написать
        </a>
      </div>
    </header>
    <slot />
    {
      COUNTER_ENABLED && !skipVisitCount && (
        <script
          define:vars={{
            COUNTER_API_BASE,
            COUNTER_WORKSPACE,
            COUNTER_NAME,
            COUNTER_API_KEY,
            VISIT_SESSION_KEY,
          }}
        >
          (() => {
            try {
              if (sessionStorage.getItem(VISIT_SESSION_KEY)) return;
            } catch {
              return;
            }

            const url = `${COUNTER_API_BASE}/${encodeURIComponent(COUNTER_WORKSPACE)}/${encodeURIComponent(COUNTER_NAME)}/up`;
            fetch(url, {
              method: 'GET',
              headers: { Authorization: `Bearer ${COUNTER_API_KEY}` },
              keepalive: true,
            })
              .then((res) => {
                if (!res.ok) return;
                try {
                  sessionStorage.setItem(VISIT_SESSION_KEY, '1');
                } catch {
                  /* ignore */
                }
              })
              .catch(() => {
                /* ignore network errors */
              });
          })();
        </script>
      )
    }
  </body>
</html>
