---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { WHATSAPP_URL, PHONE_TEL, PHONE_DISPLAY, MAX_URL } from '../consts';
import heroImage from '../assets/images/hero.webp';

const workModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/works/*.{webp,WEBP}',
  { eager: true },
);

const works = Object.entries(workModules)
  .sort(([a], [b]) => {
    const num = (path: string) =>
      Number(path.match(/(\d+)\.webp$/i)?.[1] ?? 0);
    return num(a) - num(b);
  })
  .map(([path, mod], index) => ({
    src: mod.default,
    alt: `Пример работы — фото ${index + 1}`,
    path,
  }));

const services = [
  { num: '01', title: 'Изготовление и установка зеркал' },
  { num: '02', title: 'Зеркала с подсветкой и подогревом' },
  { num: '03', title: 'Душевые кабины из закалённого стекла' },
  { num: '04', title: 'Стеклянные двери и перегородки' },
  { num: '05', title: 'Изделия из стекла и триплекс' },
  { num: '06', title: 'Замена стекла в межкомнатных дверях' },
  { num: '07', title: 'Замена зеркал в шкафах-купе' },
  { num: '08', title: 'Фотопечать и нанесение рисунка на стекло' },
];

const currentYear = new Date().getFullYear();

const faq = [
  {
    q: 'Сколько ждать заказ?',
    a: 'Точный срок называем после замера — зависит от размера, материала и загрузки. До этого ориентиры по телефону или в мессенджере.',
  },
  {
    q: 'Что нужно для расчёта?',
    a: 'Опишите задачу: помещение, примерные ширина и высота, нужна ли подсветка или особая обработка. Этого достаточно для первого ответа.',
  },
  {
    q: 'Сколько стоит выезд замерщика?',
    a: '500 ₽ в черте города. За пределы Уфы (Дёма, Затон и другие районы) — по договорённости.',
  },
  {
    q: 'Входит ли монтаж в цену изделия?',
    a: 'Нет. Установка считается отдельно — от сложности крепления и объекта. Доставка по городу — 600 ₽.',
  },
  {
    q: 'Где вы работаете?',
    a: 'По Уфе и Уфимскому району. Заявки из области принимаем — условия выезда и доставки обсуждаем индивидуально.',
  },
  {
    q: 'Как оплатить?',
    a: 'Наличными или переводом. Предоплата возможна — условия согласуем при заказе.',
  },
];
---

<BaseLayout title="Зеркала Уфы — изготовление и установка зеркал на заказ">
  <main id="top" class="pt-16 lg:pt-20">
    <section
      id="hero"
      class="min-h-[100dvh] grid grid-cols-1 lg:grid-cols-12 items-start gap-10 lg:gap-16 px-gutter pt-6 lg:pt-8 pb-section"
    >
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p
          class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
        >
          Зеркала Уфы · Мастерская
        </p>

        <h1
          class="font-display text-[clamp(3.5rem,8vw,7rem)] leading-[1.0] tracking-[-0.02em] text-ink"
        >
          Зеркала на заказ в Уфе
        </h1>

        <p
          class="font-body text-lg md:text-xl text-ink-muted max-w-[42ch] leading-[1.55]"
        >
          Изготовление и установка зеркал, душевых кабин, стеклянных
          перегородок. Индивидуальные размеры, выезд замерщика по Уфе и
          районам.
        </p>

        <div class="flex flex-col gap-4 items-start">
          <a
            href={MAX_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-brass text-surface rounded-sm px-6 py-3 min-h-[44px] inline-flex items-center gap-2 cursor-pointer shadow-reflection transition-shadow duration-[400ms] ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-safe:hover:translate-y-[-2px] motion-safe:hover:shadow-[0_35px_70px_-20px_rgba(30,27,24,0.24),0_10px_24px_-8px_rgba(30,27,24,0.12)] motion-safe:transition-transform motion-safe:duration-[400ms] motion-safe:ease-out"
          >
            <Icon
              name="lucide:message-circle"
              class="w-5 h-5"
              aria-hidden="true"
            />
            Написать в MAX
          </a>

          <a
            href="#gallery"
            class="font-body text-ink-muted underline-offset-4 min-h-[44px] inline-flex items-center cursor-pointer hover:text-ink hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            Смотреть работы
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div
          class="aspect-[4/5] lg:aspect-[3/4] rounded shadow-reflection overflow-hidden bg-surface"
        >
          <Image
            src={heroImage}
            alt="Зеркало в латунной раме в светлом интерьере"
            width={800}
            height={1000}
            loading="eager"
            fetchpriority="high"
            format="avif"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <section id="services" class="py-section px-gutter bg-ink">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-5">
          <p
            class="font-body text-xs uppercase tracking-[0.05em] text-surface/70"
          >
            Услуги
          </p>
          <h2
            class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.1] tracking-[-0.01em] text-surface max-w-[16ch]"
          >
            Наши направления
          </h2>
          <p
            class="mt-6 font-body text-surface/80 leading-[1.55] max-w-[36ch]"
          >
            Изготавливаем по вашим размерам и устанавливаем. Замер, доставка и
            монтаж по Уфе и районам.
          </p>
        </div>

        <div class="lg:col-span-7">
          <ul class="divide-y divide-surface/20 border-y border-surface/20">
            {
              services.map((service) => (
                <li class="flex items-baseline gap-6 lg:gap-10 py-6 lg:py-8">
                  <span class="font-body text-xs text-surface/70 tracking-[0.05em] shrink-0 w-8">
                    {service.num}
                  </span>
                  <h3 class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-surface">
                    {service.title}
                  </h3>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="gallery" class="py-section px-gutter bg-background">
      <header>
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Работы
        </p>
        <h2
          class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.1] tracking-[-0.01em] text-ink max-w-[20ch]"
        >
          Работы мастерской
        </h2>
      </header>

      <div class="mt-8 lg:mt-12 overflow-hidden min-w-0">
        <ul
          id="gallery-track"
          class="min-w-0 flex gap-4 lg:gap-6 overflow-x-auto snap-x snap-mandatory scroll-px-gutter px-gutter pb-8 [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-track]:bg-line/50 [&::-webkit-scrollbar-thumb]:bg-brass [&::-webkit-scrollbar-thumb]:rounded-full"
          tabindex="0"
          aria-label="Галерея работ — прокрутите горизонтально"
        >
          {
            works.map((work, index) => (
              <li
                class="group shrink-0 snap-start w-[85vw] md:w-[45vw] lg:w-[420px] transition-[transform,opacity] duration-[350ms] ease-out"
                data-slide
                data-index={index}
              >
                <figure>
                  <div class="aspect-[4/5] overflow-hidden rounded bg-surface transition-shadow duration-700 ease-out motion-safe:group-hover:shadow-[0_40px_80px_-25px_rgba(30,27,24,0.22),0_12px_28px_-10px_rgba(30,27,24,0.10)]">
                    <Image
                      src={work.src}
                      alt={work.alt}
                      width={800}
                      height={1000}
                      loading="lazy"
                      decoding="async"
                      format="avif"
                      class="w-full h-full object-cover transition-transform duration-[1200ms] ease-out motion-safe:group-hover:scale-[1.06]"
                    />
                  </div>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="contacts" class="py-section px-gutter bg-background">
      <div class="max-w-[80ch]">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Контакты
        </p>
        <h2
          class="mt-3 font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] tracking-[-0.02em] text-ink max-w-[20ch]"
        >
          Обсудим ваш проект
        </h2>
        <p
          class="mt-6 font-body text-lg text-ink-muted leading-[1.55] max-w-[50ch]"
        >
          Напишите или позвоните — обсудим размер, материал и сроки.
        </p>

        <div class="mt-8 flex items-center gap-3">
          <div>
            <p class="font-body text-sm text-ink">Олег Артемьев</p>
            <p class="font-body text-xs text-ink-muted">руководитель-исполнитель</p>
          </div>
        </div>
      </div>

      <div
        class="mt-8 lg:mt-12 grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6"
      >
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon
            name="simple-icons:whatsapp"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            WhatsApp
          </span>
          <span class="font-body text-lg lg:text-xl leading-[1.3] text-ink">
            Написать
          </span>
        </a>

        <a
          href={MAX_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          {/* TODO: заменить иконку когда MAX появится в simple-icons, пока lucide:message-circle */}
          <Icon
            name="lucide:message-circle"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            MAX
          </span>
          <span class="font-body text-lg lg:text-xl leading-[1.3] text-ink">
            Написать
          </span>
        </a>

        <a
          href={PHONE_TEL}
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon
            name="lucide:phone"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            Позвонить
          </span>
          <span
            class="font-body text-lg lg:text-xl leading-[1.3] tracking-normal text-ink tabular-nums"
          >
            {PHONE_DISPLAY}
          </span>
        </a>
      </div>

      <div class="mt-8 lg:mt-12 pt-8 border-t border-line">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Стоимость
        </p>
        <div
          class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10 max-w-[60ch]"
        >
          <div>
            <p
              class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-ink"
            >
              Выезд замерщика
            </p>
            <p class="mt-2 font-body text-sm text-ink-muted leading-[1.55]">
              500 ₽ в черте города. За пределы Уфы (Дёма, Затон и др.) — по
              договорённости.
            </p>
          </div>
          <div>
            <p
              class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-ink"
            >
              Доставка
            </p>
            <p class="mt-2 font-body text-sm text-ink-muted leading-[1.55]">
              600 ₽ по городу. Установка и монтаж — рассчитываются
              индивидуально.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-8 lg:mt-12 pt-8 border-t border-line">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Оплата
        </p>
        <div class="mt-6 max-w-[60ch]">
          <p class="font-body text-base text-ink leading-[1.6]">
            Наличными или переводом. Возможна предоплата — обсуждается
            индивидуально.
          </p>
        </div>
      </div>

    </section>

    <section id="faq" class="py-section px-gutter bg-background">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
            Вопросы
          </p>
          <h2 class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.1] tracking-[-0.01em] text-ink max-w-[12ch]">
            Частые вопросы
          </h2>
        </div>
        <div class="lg:col-span-8 border-t border-line">
          {
            faq.map((item) => (
              <div class="py-8 lg:py-10 border-b border-line">
                <h3 class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-ink">
                  {item.q}
                </h3>
                <p class="mt-3 font-body text-base text-ink-muted leading-[1.6] max-w-[60ch]">
                  {item.a}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line bg-background">
    <div class="px-gutter py-12 lg:py-16">
      <div
        class="flex flex-col gap-8 text-left lg:grid lg:grid-cols-12 lg:gap-8"
      >
        <div class="lg:col-span-5">
          <p
            class="font-display text-2xl lg:text-3xl tracking-[-0.01em] text-ink"
          >
            Зеркала Уфы
          </p>
          <p class="mt-2 font-body text-sm text-ink-muted">
            Изготовление и установка зеркал · Уфа
          </p>
        </div>

        <nav
          class="flex flex-wrap gap-6 lg:gap-8 lg:col-span-4 lg:justify-self-end"
          aria-label="Навигация в подвале"
        >
          <a
            href="#gallery"
            class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300"
          >
            Работы
          </a>
          <a
            href="#contacts"
            class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300"
          >
            Контакты
          </a>
          <a
            href="#top"
            class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300"
          >
            Наверх
          </a>
        </nav>

        <div class="lg:col-span-3 lg:text-right">
          <p class="font-body text-xs text-ink-muted">Олег Артемьев</p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            руководитель-исполнитель
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            <a
              href={PHONE_TEL}
              class="hover:text-ink transition-colors duration-300"
            >
              {PHONE_DISPLAY}
            </a>
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            Уфа, Уфимский район
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">© {currentYear}</p>
        </div>
      </div>
    </div>
  </footer>

  <script>
    let isAutoScrolling = false;
    const track = document.getElementById('gallery-track');
    if (track) {
      let isScrolling: number | undefined;

      track.addEventListener('scroll', () => {
        if (isAutoScrolling) return;

        window.clearTimeout(isScrolling);
        isScrolling = window.setTimeout(() => {
          const slides = Array.from(track.querySelectorAll('li')) as HTMLElement[];
          if (slides.length === 0) return;
          const trackLeft = track.getBoundingClientRect().left;
          let closestIndex = 0;
          let closestDistance = Infinity;
          slides.forEach((slide, index) => {
            const distance = Math.abs(slide.getBoundingClientRect().left - trackLeft);
            if (distance < closestDistance) {
              closestDistance = distance;
              closestIndex = index;
            }
          });

          const target = slides[closestIndex];
          const targetScrollLeft = target.offsetLeft - track.offsetLeft;
          const currentScrollLeft = track.scrollLeft;

          if (Math.abs(targetScrollLeft - currentScrollLeft) < 2) return;

          isAutoScrolling = true;
          track.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });

          setTimeout(() => {
            isAutoScrolling = false;
          }, 500);
        }, 200);
      });
    }

    if ('IntersectionObserver' in window) {
      const sections = document.querySelectorAll('main > section:not(#hero)');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -10% 0px' }
      );
      sections.forEach((s) => observer.observe(s));
    }

    // Фокусная лента: scale/opacity в зависимости от расстояния до центра
    const initGalleryFocus = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const track = document.getElementById('gallery-track');
      if (!track) return;

      const slides = Array.from(track.querySelectorAll('[data-slide]')) as HTMLElement[];
      if (slides.length === 0) return;

      const update = () => {
        const trackRect = track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;

        let focusedIndex = 0;
        let closest = Infinity;
        slides.forEach((slide, index) => {
          const rect = slide.getBoundingClientRect();
          const slideCenter = rect.left + rect.width / 2;
          const distance = Math.abs(slideCenter - trackCenter);
          if (distance < closest) {
            closest = distance;
            focusedIndex = index;
          }
        });

        slides.forEach((slide, index) => {
          const dist = Math.abs(index - focusedIndex);
          const isNeighbor = dist === 1;
          const isFar = dist >= 2;

          slide.style.transform = isFar
            ? 'scale(0.94)'
            : isNeighbor
              ? 'scale(0.97)'
              : 'scale(1)';
          slide.style.opacity = isFar ? '0.75' : isNeighbor ? '0.9' : '1';

          const inner = slide.querySelector('figure > div') as HTMLElement | null;
          if (!inner) return;

          if (isNeighbor) {
            inner.style.filter = 'blur(6px) grayscale(0.35)';
          } else {
            inner.style.filter = 'none';
          }
        });
      };

      let ticking = false;
      const onScroll = () => {
        if (isAutoScrolling) return;
        if (!ticking) {
          window.requestAnimationFrame(() => {
            update();
            ticking = false;
          });
          ticking = true;
        }
      };

      track.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', update);
      update();
    };

    initGalleryFocus();
  </script>
</BaseLayout>