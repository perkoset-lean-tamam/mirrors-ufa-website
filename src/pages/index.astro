---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { WHATSAPP_URL, PHONE_TEL, PHONE_DISPLAY, MAX_URL } from '../consts';
import heroImage from '../assets/images/herowide.jpg';

const workModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/works/*.{webp,WEBP}',
  { eager: true },
);

const works = Object.entries(workModules)
  .sort(([a], [b]) => {
    const num = (path: string) =>
      Number(path.match(/(\d+)\.webp$/i)?.[1] ?? 0);
    return num(a) - num(b);
  })
  .map(([path, mod], index) => ({
    src: mod.default,
    alt: `Пример работы — фото ${index + 1}`,
    path,
  }));

const services = [
  { num: '01', title: 'Изготовление и установка зеркал' },
  { num: '02', title: 'Зеркала с подсветкой и подогревом' },
  { num: '03', title: 'Душевые кабины из закалённого стекла' },
  { num: '04', title: 'Стеклянные двери и перегородки' },
  { num: '05', title: 'Изделия из стекла и триплекс' },
  { num: '06', title: 'Замена стекла в межкомнатных дверях' },
  { num: '07', title: 'Замена зеркал в шкафах-купе' },
  { num: '08', title: 'Фотопечать и нанесение рисунка на стекло' },
];

const currentYear = new Date().getFullYear();

const faq = [
  {
    q: 'Сколько ждать заказ?',
    a: 'Точный срок называем после замера — зависит от размера, материала и загрузки. До этого ориентиры по телефону или в мессенджере.',
  },
  {
    q: 'Что нужно для расчёта?',
    a: 'Опишите задачу: помещение, примерные ширина и высота, нужна ли подсветка или особая обработка. Этого достаточно для первого ответа.',
  },
  {
    q: 'Сколько стоит выезд замерщика?',
    a: '500 ₽ в черте города. За пределы Уфы (Дёма, Затон и другие районы) — по договорённости.',
  },
  {
    q: 'Где вы работаете?',
    a: 'По Уфе и Уфимскому району. Заявки из области принимаем — условия выезда и доставки обсуждаем индивидуально.',
  },
  {
    q: 'Как оплатить?',
    a: 'Наличными или переводом. Предоплата возможна — условия согласуем при заказе.',
  },
];
---

<BaseLayout title="Зеркала Уфы — изготовление и установка зеркал на заказ">
  <main id="top" class="pt-16 lg:pt-20">
    <section
      id="hero"
      class="relative isolate overflow-hidden min-h-[85dvh] lg:min-h-[calc(100dvh-5rem)] flex items-center px-gutter py-section"
    >
      <Image
        src={heroImage}
        alt="Зеркало в светлом интерьере"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="avif"
        class="absolute inset-0 -z-20 w-full h-full object-cover"
      />
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-r from-emerald/90 via-emerald/55 via-60% to-transparent"
        aria-hidden="true"
      >
      </div>

      <div class="flex flex-col gap-6 max-w-[60rem]">
        <p
          class="font-body text-xs uppercase tracking-[0.05em] text-brass-light"
        >
          Зеркала Уфы · Мастерская
        </p>

        <h1
          class="font-display text-[clamp(3.5rem,8vw,7rem)] leading-[1.0] tracking-[-0.02em] text-surface"
        >
          Зеркала на заказ в Уфе
        </h1>

        <p
          class="font-body text-lg md:text-xl text-surface/90 max-w-[42ch] leading-[1.55]"
        >
          Изготовление и установка зеркал, душевых кабин, стеклянных
          перегородок. Индивидуальные размеры, выезд замерщика по Уфе и
          районам.
        </p>

        <div class="flex flex-col gap-4 items-start">
          <a
            href={MAX_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-terracotta text-surface rounded-sm px-6 py-3 min-h-[44px] inline-flex items-center gap-2 cursor-pointer shadow-reflection transition-shadow duration-[400ms] ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-safe:hover:translate-y-[-2px] motion-safe:hover:shadow-[0_35px_70px_-20px_rgba(30,27,24,0.24),0_10px_24px_-8px_rgba(30,27,24,0.12)] motion-safe:transition-transform motion-safe:duration-[400ms] motion-safe:ease-out"
          >
            <Icon
              name="lucide:message-circle"
              class="w-5 h-5"
              aria-hidden="true"
            />
            Написать в MAX
          </a>

          <a
            href="#gallery"
            class="font-body text-surface/90 underline-offset-4 min-h-[44px] inline-flex items-center cursor-pointer hover:text-surface hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass-light focus-visible:ring-offset-2 focus-visible:ring-offset-emerald"
          >
            Смотреть работы
          </a>
        </div>
      </div>

    </section>

    <section id="services" class="py-section px-gutter bg-emerald">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-5">
          <p
            class="font-body text-xs uppercase tracking-[0.05em] text-surface/70"
          >
            Услуги
          </p>
          <h2
            class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.1] tracking-[-0.01em] text-surface max-w-[16ch]"
          >
            Наши направления
          </h2>
          <p
            class="mt-6 font-body text-surface/80 leading-[1.55] max-w-[36ch]"
          >
            Изготавливаем по вашим размерам и устанавливаем. Замер, доставка и
            монтаж по Уфе и районам.
          </p>
        </div>

        <div class="lg:col-span-7">
          <ul class="divide-y divide-surface/20 border-y border-surface/20">
            {
              services.map((service) => (
                <li class="flex items-baseline gap-6 lg:gap-10 py-6 lg:py-8">
                  <span class="font-body text-xs text-brass-light tracking-[0.05em] shrink-0 w-8">
                    {service.num}
                  </span>
                  <h3 class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-surface">
                    {service.title}
                  </h3>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="gallery" class="py-section px-gutter bg-sand">
      <header>
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Работы
        </p>
        <h2
          class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.1] tracking-[-0.01em] text-ink max-w-[20ch]"
        >
          Работы мастерской
        </h2>
      </header>

      <div class="mt-8 lg:mt-12 relative min-w-0">
        <ul
          id="gallery-track"
          class="min-w-0 flex gap-4 lg:gap-6 overflow-x-auto snap-x snap-mandatory scroll-px-gutter px-gutter pb-4 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]"
          style="scrollbar-width: none; -ms-overflow-style: none;"
          tabindex="0"
          aria-label="Галерея работ"
        >
          {
            works.map((work, index) => (
              <li
                class="group shrink-0 snap-start w-[85vw] md:w-[45vw] lg:w-[420px] transition-opacity duration-[350ms] ease-out"
                data-slide
                data-index={index}
              >
                <figure>
                  <button
                    type="button"
                    data-lightbox-open
                    data-index={index}
                    aria-label={`Открыть фото ${index + 1}`}
                    class="block w-full cursor-pointer text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    <div class="aspect-[4/5] overflow-hidden rounded bg-surface transition-shadow duration-700 ease-out motion-safe:group-hover:shadow-[0_40px_80px_-25px_rgba(30,27,24,0.22),0_12px_28px_-10px_rgba(30,27,24,0.10)]">
                      <Image
                        src={work.src}
                        alt={work.alt}
                        width={800}
                        height={1000}
                        loading="lazy"
                        decoding="async"
                        format="avif"
                        class="w-full h-full object-cover transition-transform duration-[1200ms] ease-out motion-safe:group-hover:scale-[1.06]"
                      />
                    </div>
                  </button>
                </figure>
              </li>
            ))
          }
        </ul>

        <div class="mt-6 flex items-center gap-2 px-gutter">
          <button
            type="button"
            id="gallery-prev"
            aria-controls="gallery-track"
            aria-label="Предыдущее фото"
            class="group/nav inline-flex items-center gap-2 border border-line rounded-sm pl-3 pr-4 py-2.5 min-h-[44px] font-body text-xs uppercase tracking-[0.05em] text-ink transition-[color,border-color,background-color,transform] duration-[400ms] ease-out hover:border-brass hover:text-brass hover:bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:opacity-35 disabled:cursor-not-allowed disabled:hover:border-line disabled:hover:text-ink disabled:hover:bg-transparent motion-safe:hover:translate-y-[-1px] motion-safe:disabled:hover:translate-y-0"
          >
            <Icon name="lucide:chevron-left" class="w-4 h-4 shrink-0 transition-transform duration-[400ms] ease-out motion-safe:group-hover/nav:-translate-x-0.5" aria-hidden="true" />
            Назад
          </button>
          <button
            type="button"
            id="gallery-next"
            aria-controls="gallery-track"
            aria-label="Следующее фото"
            class="group/nav inline-flex items-center gap-2 border border-line rounded-sm pl-4 pr-3 py-2.5 min-h-[44px] font-body text-xs uppercase tracking-[0.05em] text-ink transition-[color,border-color,background-color,transform] duration-[400ms] ease-out hover:border-brass hover:text-brass hover:bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:opacity-35 disabled:cursor-not-allowed disabled:hover:border-line disabled:hover:text-ink disabled:hover:bg-transparent motion-safe:hover:translate-y-[-1px] motion-safe:disabled:hover:translate-y-0"
          >
            Вперёд
            <Icon name="lucide:chevron-right" class="w-4 h-4 shrink-0 transition-transform duration-[400ms] ease-out motion-safe:group-hover/nav:translate-x-0.5" aria-hidden="true" />
          </button>
        </div>
      </div>
    </section>

    <section id="contacts" class="py-section px-gutter bg-background">
      <div class="max-w-[80ch]">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Контакты
        </p>
        <h2
          class="mt-3 font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] tracking-[-0.02em] text-ink max-w-[20ch]"
        >
          Обсудим ваш проект
        </h2>
        <p
          class="mt-6 font-body text-lg text-ink-muted leading-[1.55] max-w-[50ch]"
        >
          Напишите или позвоните — обсудим размер, материал и сроки.
        </p>

        <div class="mt-8 flex items-center gap-3">
          <div>
            <p class="font-body text-sm text-ink">Олег Артемьев</p>
            <p class="font-body text-xs text-ink-muted">руководитель-исполнитель</p>
          </div>
        </div>
      </div>

      <div
        class="mt-8 lg:mt-12 grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6"
      >
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line border-t-4 border-t-terracotta rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon
            name="simple-icons:whatsapp"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            WhatsApp
          </span>
          <span class="font-body text-lg lg:text-xl leading-[1.3] text-ink">
            Написать
          </span>
        </a>

        <a
          href={MAX_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line border-t-4 border-t-terracotta rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          {/* TODO: заменить иконку когда MAX появится в simple-icons, пока lucide:message-circle */}
          <Icon
            name="lucide:message-circle"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            MAX
          </span>
          <span class="font-body text-lg lg:text-xl leading-[1.3] text-ink">
            Написать
          </span>
        </a>

        <a
          href={PHONE_TEL}
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line border-t-4 border-t-terracotta rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon
            name="lucide:phone"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            Позвонить
          </span>
          <span
            class="font-body text-lg lg:text-xl leading-[1.3] tracking-normal text-ink tabular-nums"
          >
            {PHONE_DISPLAY}
          </span>
        </a>
      </div>

      <div class="mt-8 lg:mt-12 pt-8 border-t border-line">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Стоимость
        </p>
        <div
          class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10 max-w-[60ch]"
        >
          <div>
            <p
              class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-ink"
            >
              Выезд замерщика
            </p>
            <p class="mt-2 font-body text-sm text-ink-muted leading-[1.55]">
              500 ₽ в черте города. За пределы Уфы (Дёма, Затон и др.) — по
              договорённости.
            </p>
          </div>
          <div>
            <p
              class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-ink"
            >
              Доставка
            </p>
            <p class="mt-2 font-body text-sm text-ink-muted leading-[1.55]">
              600 ₽ по городу. Установка и монтаж — рассчитываются
              индивидуально.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-8 lg:mt-12 pt-8 border-t border-line">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Оплата
        </p>
        <div class="mt-6 max-w-[60ch]">
          <p class="font-body text-base text-ink leading-[1.6]">
            Наличными или переводом. Возможна предоплата — обсуждается
            индивидуально.
          </p>
        </div>
      </div>

    </section>

    <section id="faq" class="py-section px-gutter bg-teal-soft">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
            Вопросы
          </p>
          <h2 class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.1] tracking-[-0.01em] text-ink max-w-[12ch]">
            Частые вопросы
          </h2>
        </div>
        <div class="lg:col-span-8 border-t border-line">
          {
            faq.map((item) => (
              <div class="py-8 lg:py-10 border-b border-line">
                <h3 class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-ink">
                  {item.q}
                </h3>
                <p class="mt-3 font-body text-base text-ink-muted leading-[1.6] max-w-[60ch]">
                  {item.a}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line bg-background">
    <div class="px-gutter py-12 lg:py-16">
      <div
        class="flex flex-col gap-8 text-left lg:grid lg:grid-cols-12 lg:gap-8"
      >
        <div class="lg:col-span-5">
          <p
            class="font-display text-2xl lg:text-3xl tracking-[-0.01em] text-ink"
          >
            Зеркала Уфы
          </p>
          <p class="mt-2 font-body text-sm text-ink-muted">
            Изготовление и установка зеркал · Уфа
          </p>
        </div>

        <nav
          class="flex flex-wrap gap-6 lg:gap-8 lg:col-span-4 lg:justify-self-end"
          aria-label="Навигация в подвале"
        >
          <a
            href="#gallery"
            class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300"
          >
            Работы
          </a>
          <a
            href="#contacts"
            class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300"
          >
            Контакты
          </a>
        </nav>

        <div class="lg:col-span-3 lg:text-right">
          <p class="font-body text-xs text-ink-muted">Олег Артемьев</p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            руководитель-исполнитель
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            <a
              href={PHONE_TEL}
              class="hover:text-ink transition-colors duration-300"
            >
              {PHONE_DISPLAY}
            </a>
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            Уфа, Уфимский район
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">© {currentYear}</p>
        </div>
      </div>
    </div>
  </footer>

  <a
    id="scroll-top"
    href="#top"
    aria-label="Наверх"
    class="fixed bottom-6 right-6 z-50 flex h-11 w-11 items-center justify-center rounded-full bg-brass text-surface shadow-reflection opacity-0 invisible pointer-events-none transition-[opacity,visibility,transform] duration-[400ms] ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-safe:hover:translate-y-[-2px] data-[visible]:opacity-100 data-[visible]:visible data-[visible]:pointer-events-auto"
  >
    <Icon name="lucide:arrow-up" class="w-5 h-5" aria-hidden="true" />
  </a>

  <dialog
    id="lightbox"
    aria-label="Просмотр фото"
    class="lightbox fixed inset-0 m-0 max-h-none max-w-none w-full h-full bg-transparent p-0 open:flex items-center justify-center"
  >
    <div
      id="lightbox-stage"
      class="relative z-10 flex max-h-[90vh] max-w-[90vw] items-center justify-center touch-pan-y"
    >
      <img
        id="lightbox-image"
        alt=""
        class="max-h-[90vh] max-w-[90vw] object-contain shadow-reflection select-none"
        draggable="false"
      />
    </div>
    <button
      type="button"
      id="lightbox-close"
      aria-label="Закрыть"
      class="absolute top-4 right-4 z-20 flex h-11 w-11 items-center justify-center rounded-full bg-brass text-surface cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-ink"
    >
      <Icon name="lucide:x" class="w-5 h-5" aria-hidden="true" />
    </button>
    <button
      type="button"
      id="lightbox-prev"
      aria-label="Предыдущее фото"
      class="absolute left-4 top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-brass text-surface cursor-pointer lg:flex focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-ink disabled:opacity-40 disabled:cursor-not-allowed disabled:pointer-events-none"
    >
      <Icon name="lucide:chevron-left" class="w-5 h-5" aria-hidden="true" />
    </button>
    <button
      type="button"
      id="lightbox-next"
      aria-label="Следующее фото"
      class="absolute right-4 top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-brass text-surface cursor-pointer lg:flex focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-ink disabled:opacity-40 disabled:cursor-not-allowed disabled:pointer-events-none"
    >
      <Icon name="lucide:chevron-right" class="w-5 h-5" aria-hidden="true" />
    </button>
  </dialog>

  <style>
    .lightbox::backdrop {
      background: rgba(30, 27, 24, 0.88);
    }
    .lightbox {
      opacity: 0;
      transition: opacity 400ms ease-out;
    }
    .lightbox[open] {
      opacity: 1;
    }
    @media (prefers-reduced-motion: reduce) {
      .lightbox {
        transition: none;
      }
    }
  </style>

  <script>
    const scrollTopBtn = document.getElementById('scroll-top');
    if (scrollTopBtn) {
      const toggleScrollTop = () => {
        if (window.scrollY > 300) {
          scrollTopBtn.setAttribute('data-visible', '');
        } else {
          scrollTopBtn.removeAttribute('data-visible');
        }
      };
      toggleScrollTop();
      window.addEventListener('scroll', toggleScrollTop, { passive: true });
    }

    if ('IntersectionObserver' in window) {
      const sections = document.querySelectorAll('main > section:not(#hero)');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -10% 0px' }
      );
      sections.forEach((s) => observer.observe(s));
    }

    const initGallery = () => {
      const track = document.getElementById('gallery-track');
      const prevBtn = document.getElementById('gallery-prev');
      const nextBtn = document.getElementById('gallery-next');
      if (!track) return;

      const getSlides = () =>
        Array.from(track.querySelectorAll('[data-slide]')) as HTMLElement[];

      let currentIndex = 0;
      let isAutoScrolling = false;
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      const updateFocus = (index: number) => {
        const list = getSlides();
        list.forEach((slide, i) => {
          slide.style.opacity = i === index ? '1' : '0.55';
          slide.style.transform = '';
          const inner = slide.querySelector('figure div') as HTMLElement | null;
          if (inner) inner.style.filter = 'none';
        });
        if (prevBtn instanceof HTMLButtonElement) {
          prevBtn.disabled = index <= 0;
        }
        if (nextBtn instanceof HTMLButtonElement) {
          nextBtn.disabled = index >= list.length - 1;
        }
      };

      const indexFromScroll = () => {
        const list = getSlides();
        if (list.length === 0) return 0;
        if (track.scrollLeft < 8) return 0;

        const trackRect = track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;
        let best = 0;
        let closest = Infinity;
        list.forEach((slide, i) => {
          const rect = slide.getBoundingClientRect();
          const slideCenter = rect.left + rect.width / 2;
          const distance = Math.abs(slideCenter - trackCenter);
          if (distance < closest) {
            closest = distance;
            best = i;
          }
        });
        return best;
      };

      const goTo = (index: number) => {
        const list = getSlides();
        if (list.length === 0) return;
        currentIndex = Math.max(0, Math.min(index, list.length - 1));
        const target = list[currentIndex];
        const left = target.offsetLeft - track.offsetLeft;
        isAutoScrolling = true;
        track.scrollTo({
          left,
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
        updateFocus(currentIndex);
        window.setTimeout(
          () => {
            isAutoScrolling = false;
          },
          reduceMotion ? 0 : 500,
        );
      };

      prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
      nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));

      let ticking = false;
      let snapTimer: number | undefined;
      track.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              if (!isAutoScrolling) {
                currentIndex = indexFromScroll();
                updateFocus(currentIndex);
              }
              ticking = false;
            });
            ticking = true;
          }

          if (isAutoScrolling) return;
          window.clearTimeout(snapTimer);
          snapTimer = window.setTimeout(() => {
            goTo(indexFromScroll());
          }, 200);
        },
        { passive: true },
      );

      window.addEventListener('resize', () => {
        currentIndex = indexFromScroll();
        updateFocus(currentIndex);
      });

      updateFocus(0);
    };

    initGallery();

    const initLightbox = () => {
      const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
      const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
      const closeBtn = document.getElementById('lightbox-close');
      const prevBtn = document.getElementById('lightbox-prev');
      const nextBtn = document.getElementById('lightbox-next');
      const gallery = document.getElementById('gallery-track');
      if (!dialog || !image || !gallery) return;

      const getSlides = () =>
        Array.from(gallery.querySelectorAll('[data-lightbox-open]')) as HTMLElement[];

      let currentIndex = 0;

      const updateNavButtons = (total: number) => {
        if (prevBtn instanceof HTMLButtonElement) {
          prevBtn.disabled = currentIndex <= 0;
        }
        if (nextBtn instanceof HTMLButtonElement) {
          nextBtn.disabled = currentIndex >= total - 1;
        }
      };

      const showAt = (index: number) => {
        const slides = getSlides();
        if (slides.length === 0) return;
        currentIndex = Math.max(0, Math.min(index, slides.length - 1));
        const trigger = slides[currentIndex];
        const thumb = trigger.querySelector('img') as HTMLImageElement | null;
        if (!thumb) return;
        image.src = thumb.currentSrc || thumb.src;
        image.srcset = thumb.srcset || '';
        image.sizes = '90vw';
        image.alt = thumb.alt || '';
        updateNavButtons(slides.length);
      };

      const open = (index: number) => {
        showAt(index);
        dialog.showModal();
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      };

      const close = () => {
        if (!dialog.open) return;
        dialog.close();
      };

      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
        image.removeAttribute('src');
        image.removeAttribute('srcset');
      });

      gallery.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        const trigger = target?.closest('[data-lightbox-open]') as HTMLElement | null;
        if (!trigger || !gallery.contains(trigger)) return;
        const index = Number(trigger.dataset.index ?? '0');
        open(Number.isFinite(index) ? index : 0);
      });

      closeBtn?.addEventListener('click', close);
      prevBtn?.addEventListener('click', () => showAt(currentIndex - 1));
      nextBtn?.addEventListener('click', () => showAt(currentIndex + 1));

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (!dialog.open) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showAt(currentIndex - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          showAt(currentIndex + 1);
        }
      });

      const stage = document.getElementById('lightbox-stage');
      if (stage) {
        let touchStartX = 0;
        let touchStartY = 0;

        stage.addEventListener(
          'touchstart',
          (event) => {
            const touch = event.changedTouches[0];
            if (!touch) return;
            touchStartX = touch.clientX;
            touchStartY = touch.clientY;
          },
          { passive: true },
        );

        stage.addEventListener(
          'touchend',
          (event) => {
            const touch = event.changedTouches[0];
            if (!touch) return;
            const deltaX = touch.clientX - touchStartX;
            const deltaY = touch.clientY - touchStartY;
            if (Math.abs(deltaX) < 50) return;
            if (Math.abs(deltaX) <= Math.abs(deltaY)) return;
            if (deltaX < 0) {
              showAt(currentIndex + 1);
            } else {
              showAt(currentIndex - 1);
            }
          },
          { passive: true },
        );
      }
    };

    initLightbox();
  </script>
</BaseLayout>