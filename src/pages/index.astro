---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

// WhatsApp для заявок
const WHATSAPP_URL =
  'https://wa.me/79177825102?text=Здравствуйте!%20Интересует%20зеркало%20на%20заказ';

// Телефон для звонков
const PHONE_TEL = 'tel:+79373398232';
const PHONE_DISPLAY = '+7 937 339 8232';

// MAX
const MAX_URL = 'https://web.max.ru/63876228';

const works = [
  { src: '/images/works/1.webp', alt: 'Пример работы — фото 1' },
  { src: '/images/works/2.webp', alt: 'Пример работы — фото 2' },
  { src: '/images/works/3.webp', alt: 'Пример работы — фото 3' },
  { src: '/images/works/4.webp', alt: 'Пример работы — фото 4' },
  { src: '/images/works/5.webp', alt: 'Пример работы — фото 5' },
  { src: '/images/works/6.webp', alt: 'Пример работы — фото 6' },
  { src: '/images/works/7.webp', alt: 'Пример работы — фото 7' },
  { src: '/images/works/8.webp', alt: 'Пример работы — фото 8' },
  { src: '/images/works/9.webp', alt: 'Пример работы — фото 9' },
  { src: '/images/works/10.webp', alt: 'Пример работы — фото 10' },
  { src: '/images/works/11.webp', alt: 'Пример работы — фото 11' },
  { src: '/images/works/12.webp', alt: 'Пример работы — фото 12' },
  { src: '/images/works/13.webp', alt: 'Пример работы — фото 13' },
  { src: '/images/works/14.webp', alt: 'Пример работы — фото 14' },
  { src: '/images/works/15.webp', alt: 'Пример работы — фото 15' },
  { src: '/images/works/16.webp', alt: 'Пример работы — фото 16' },
  { src: '/images/works/17.webp', alt: 'Пример работы — фото 17' },
  { src: '/images/works/18.webp', alt: 'Пример работы — фото 18' },
  { src: '/images/works/19.webp', alt: 'Пример работы — фото 19' },
  { src: '/images/works/20.webp', alt: 'Пример работы — фото 20' },
  { src: '/images/works/21.webp', alt: 'Пример работы — фото 21' },
];

const services = [
  { num: '01', title: 'Изготовление и установка зеркал' },
  { num: '02', title: 'Зеркала с подсветкой и подогревом' },
  { num: '03', title: 'Душевые кабины из закалённого стекла' },
  { num: '04', title: 'Стеклянные двери и перегородки' },
  { num: '05', title: 'Изделия из стекла и триплекс' },
  { num: '06', title: 'Замена стекла в межкомнатных дверях' },
  { num: '07', title: 'Замена зеркал в шкафах-купе' },
  { num: '08', title: 'Фотопечать и нанесение рисунка на стекло' },
];

const currentYear = new Date().getFullYear();
---

<BaseLayout title="Зеркала Уфы — изготовление и установка зеркал на заказ">
  <main id="top">
    <section
      class="min-h-[100dvh] grid grid-cols-1 lg:grid-cols-12 items-center gap-10 lg:gap-16 px-gutter py-section"
    >
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p
          class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
        >
          Зеркала Уфы · Мастерская
        </p>

        <h1
          class="font-display text-[clamp(3.5rem,8vw,7rem)] leading-[1.0] tracking-[-0.02em] text-ink"
        >
          Зеркала на заказ в Уфе
        </h1>

        <p
          class="font-body text-lg md:text-xl text-ink-muted max-w-[42ch] leading-[1.55]"
        >
          Изготовление и установка зеркал, душевых кабин, стеклянных
          перегородок. Индивидуальные размеры, выезд замерщика по городу и
          области.
        </p>

        <div class="flex flex-col gap-4 items-start">
          <a
            href={MAX_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-brass text-surface rounded-sm px-6 py-3 min-h-[44px] inline-flex items-center gap-2 cursor-pointer shadow-reflection transition-shadow duration-[400ms] ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-safe:hover:translate-y-[-2px] motion-safe:hover:shadow-[0_35px_70px_-20px_rgba(30,27,24,0.24),0_10px_24px_-8px_rgba(30,27,24,0.12)] motion-safe:transition-transform motion-safe:duration-[400ms] motion-safe:ease-out"
          >
            <Icon
              name="lucide:message-circle"
              class="w-5 h-5"
              aria-hidden="true"
            />
            Написать в MAX
          </a>

          <a
            href="#gallery"
            class="font-body text-ink-muted underline-offset-4 min-h-[44px] inline-flex items-center cursor-pointer hover:text-ink hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            Смотреть работы
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div
          class="aspect-[4/5] lg:aspect-[3/4] rounded shadow-reflection overflow-hidden bg-surface"
        >
          <img
            src="/images/hero.webp"
            alt="Зеркало в латунной раме в светлом интерьере"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <section id="services" class="py-section px-gutter bg-ink">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-5">
          <p
            class="font-body text-xs uppercase tracking-[0.05em] text-surface/70"
          >
            Услуги
          </p>
          <h2
            class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.1] tracking-[-0.01em] text-surface max-w-[16ch]"
          >
            Наши направления
          </h2>
          <p
            class="mt-6 font-body text-surface/80 leading-[1.55] max-w-[36ch]"
          >
            Изготавливаем по вашим размерам и устанавливаем. Замер, доставка и
            монтаж по Уфе и области.
          </p>
        </div>

        <div class="lg:col-span-7">
          <ul class="divide-y divide-surface/20 border-y border-surface/20">
            {
              services.map((service) => (
                <li class="flex items-baseline gap-6 lg:gap-10 py-6 lg:py-8">
                  <span class="font-body text-xs text-surface/70 tracking-[0.05em] shrink-0 w-8">
                    {service.num}
                  </span>
                  <h3 class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-surface">
                    {service.title}
                  </h3>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="gallery" class="py-section px-gutter bg-background">
      <header>
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Работы
        </p>
        <h2
          class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.1] tracking-[-0.01em] text-ink max-w-[20ch]"
        >
          Работы мастерской
        </h2>
      </header>

      <div class="mt-12 lg:mt-16 overflow-hidden min-w-0">
        <ul
          class="min-w-0 flex gap-4 lg:gap-6 overflow-x-auto snap-x snap-proximity scroll-px-gutter px-gutter pb-8 [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-track]:bg-line/50 [&::-webkit-scrollbar-thumb]:bg-brass [&::-webkit-scrollbar-thumb]:rounded-full"
          tabindex="0"
          aria-label="Галерея работ — прокрутите горизонтально"
        >
          {
            works.map((work) => (
              <li class="shrink-0 w-[80vw] md:w-[45vw] lg:w-[500px] snap-start">
                <figure>
                  <div class="aspect-[4/5] overflow-hidden rounded bg-surface">
                    <img
                      src={work.src}
                      alt={work.alt}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-700 ease-out motion-safe:hover:scale-[1.015]"
                    />
                  </div>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="contacts" class="py-section px-gutter bg-background">
      <div class="max-w-[80ch]">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Контакты
        </p>
        <h2
          class="mt-3 font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] tracking-[-0.02em] text-ink max-w-[20ch]"
        >
          Обсудим ваш проект
        </h2>
        <p
          class="mt-6 font-body text-lg text-ink-muted leading-[1.55] max-w-[50ch]"
        >
          Напишите или позвоните — обсудим размер, материал и сроки. Замер по
          Уфе бесплатный.
        </p>
      </div>

      <div
        class="mt-12 lg:mt-16 grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6"
      >
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon
            name="simple-icons:whatsapp"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            WhatsApp
          </span>
          <span class="font-body text-lg lg:text-xl leading-[1.3] text-ink">
            Написать
          </span>
        </a>

        <a
          href={MAX_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          {/* TODO: заменить иконку когда MAX появится в simple-icons, пока lucide:message-circle */}
          <Icon
            name="lucide:message-circle"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            MAX
          </span>
          <span class="font-body text-lg lg:text-xl leading-[1.3] text-ink">
            Написать
          </span>
        </a>

        <a
          href={PHONE_TEL}
          class="group flex flex-col gap-3 p-6 lg:p-8 min-h-[140px] bg-surface border border-line rounded hover:border-ink/30 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon
            name="lucide:phone"
            class="w-6 h-6 text-ink-muted group-hover:text-ink transition-colors duration-300"
            aria-hidden="true"
          />
          <span
            class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted"
          >
            Позвонить
          </span>
          <span
            class="font-body text-lg lg:text-xl leading-[1.3] tracking-normal text-ink tabular-nums"
          >
            {PHONE_DISPLAY}
          </span>
        </a>
      </div>

      <div class="mt-12 lg:mt-16 pt-8 border-t border-line">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Стоимость
        </p>
        <div
          class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10 max-w-[60ch]"
        >
          <div>
            <p
              class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-ink"
            >
              Выезд замерщика
            </p>
            <p class="mt-2 font-body text-sm text-ink-muted leading-[1.55]">
              500 ₽ в черте города. За пределы Уфы (Дёма, Затон и др.) — по
              договорённости.
            </p>
          </div>
          <div>
            <p
              class="font-display text-xl lg:text-2xl leading-[1.2] tracking-[-0.01em] text-ink"
            >
              Доставка
            </p>
            <p class="mt-2 font-body text-sm text-ink-muted leading-[1.55]">
              600 ₽ по городу. Установка и монтаж — рассчитываются
              индивидуально.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-12 lg:mt-16 pt-8 border-t border-line">
        <p class="font-body text-xs uppercase tracking-[0.05em] text-ink-muted">
          Оплата
        </p>
        <div class="mt-6 max-w-[60ch]">
          <p class="font-body text-base text-ink leading-[1.6]">
            Наличными или переводом. Возможна предоплата — обсуждается
            индивидуально.
          </p>
        </div>
      </div>

      <div class="mt-12 lg:mt-16 pt-8 border-t border-line">
        <div
          class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6"
        >
          <div>
            <p class="font-body text-sm text-ink-muted">Контактное лицо</p>
            <p class="mt-2 font-body text-xl lg:text-2xl text-ink">
              Олег Артемьев
            </p>
            <p class="mt-1 font-body text-sm text-ink-muted">
              руководитель-исполнитель
            </p>
          </div>
          <div class="font-body text-sm text-ink-muted">
            <p>Уфа, Уфимский район</p>
            <p class="mt-1">Работаем по Уфе и Уфимскому району</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="mt-section border-t border-line bg-background">
    <div class="px-gutter py-12 lg:py-16">
      <div
        class="flex flex-col gap-8 text-left lg:grid lg:grid-cols-12 lg:gap-8"
      >
        <div class="lg:col-span-5">
          <p
            class="font-display text-2xl lg:text-3xl tracking-[-0.01em] text-ink"
          >
            Зеркала Уфы
          </p>
          <p class="mt-2 font-body text-sm text-ink-muted">
            Изготовление и установка зеркал · Уфа
          </p>
        </div>

        <nav
          class="flex flex-wrap gap-6 lg:gap-8 lg:col-span-4 lg:justify-self-end"
          aria-label="Навигация в подвале"
        >
          <a
            href="#gallery"
            class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300"
          >
            Работы
          </a>
          <a
            href="#contacts"
            class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300"
          >
            Контакты
          </a>
          <a
            href="#top"
            class="font-body text-sm text-ink-muted hover:text-ink transition-colors duration-300"
          >
            Наверх
          </a>
        </nav>

        <div class="lg:col-span-3 lg:text-right">
          <p class="font-body text-xs text-ink-muted">Олег Артемьев</p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            руководитель-исполнитель
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            <a
              href={PHONE_TEL}
              class="hover:text-ink transition-colors duration-300"
            >
              {PHONE_DISPLAY}
            </a>
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">
            Уфа, Уфимский район
          </p>
          <p class="mt-1 font-body text-xs text-ink-muted">© {currentYear}</p>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>